{
  "name": "demogod",
  "version": "0.1.0",
  "type": "module",
  "description": "Demo video generator for GitHub Copilot CLI",
  "scripts": {
    "postinstall": "node -e \"if(process.platform!=='win32'){const g=require('path').join('node_modules','node-pty','prebuilds');require('child_process').execSync('find '+g+' -name spawn-helper -exec chmod +x {} +',{stdio:'ignore'})}\" || true",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:desktop": "tauri build",
    "record": "node scripts/record.mjs",
    "record:demo": "node scripts/record.mjs --demo",
    "test": "vitest run tests/unit && npx playwright test",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:showcase": "npx playwright test tests/showcase --headed",
    "test:generated": "npx playwright test tests/generated --headed"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "playwright": "^1.59.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
